{
  "name": "fundbrave-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/web",
    "packages/api"
  ],
  "scripts": {
    "dev": "npm run mvp",
    "mvp": "npm-run-all --parallel mvp:web mvp:api",
    "mvp:web": "npm run dev --workspace=web",
    "mvp:api": "npm run start:dev --workspace=api",
    "mvp:db": "docker compose up -d postgres",
    "db:push": "npm run prisma:push --workspace=api",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "install:all": "npm install"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
