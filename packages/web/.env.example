# Base URL of the FundBrave API (packages/api, NestJS)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Privy application ID from dashboard.privy.io (used in phase 1 auth)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# WalletConnect project ID from cloud.walletconnect.com (phase 3 wallet donations).
# When missing, the app runs in degraded mode: the "Pay with wallet" tab is
# hidden and only address/QR donations are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
