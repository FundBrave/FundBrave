# ─── Core ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://fundbrave:fundbrave@localhost:5432/fundbrave_mvp?schema=public

# ─── Privy (auth + user wallets) — https://dashboard.privy.io ───
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# JWKS endpoint is derived from app id; no extra config needed.

# ─── Chains ─────────────────────────────────────────────────────
# testnet (default for MVP build): 84532 = Base Sepolia
DEFAULT_CHAIN_ID=84532
# Comma-separated chain ids enabled for donation tracking.
# Testnets: 84532 (Base Sepolia), 11155111 (Sepolia)
# Mainnets (enable at launch): 8453 (Base), 1 (Ethereum), 137 (Polygon), 42161 (Arbitrum)
ENABLED_CHAIN_IDS=84532,11155111
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ─── Safe 2-of-2 ────────────────────────────────────────────────
# Root admin signer address (2nd owner on every campaign Safe). Use a hardware wallet on mainnet.
ROOT_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
# Relayer key used ONLY to pay gas for Safe deployment + execTransaction submission (never an owner).
RELAYER_PRIVATE_KEY=0x-your-relayer-private-key

# ─── Donation detection ─────────────────────────────────────────
# Public base URL of THIS API for Moralis webhooks (use ngrok/cloudflared in dev).
# Leave empty to disable streams — the RPC poller still detects ERC-20 donations.
WEBHOOK_BASE_URL=
# Moralis Streams — https://admin.moralis.com
MORALIS_API_KEY=your-moralis-api-key
MORALIS_STREAM_SECRET=your-moralis-webhook-secret
# Price feed
COINGECKO_API_KEY=optional-demo-key
# Confirmations required before a donation is CONFIRMED
DONATION_CONFIRMATIONS=5

# ─── Media (S3) ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=fundbrave-mvp-media
# Optional CDN/base URL for serving uploads (defaults to the bucket URL)
S3_PUBLIC_URL=

# ─── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=FundBrave <no-reply@fundbrave.example>

# ─── Admin bootstrap ────────────────────────────────────────────
# This email is auto-granted ADMIN role + whitelist on first login.
ROOT_ADMIN_EMAIL=okwuosahpaschal@gmail.com
